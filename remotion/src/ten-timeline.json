 "subs": [
  {
   "text": "Boys, I\u2019ve got incredible news. I saved everyone seven dollars and forty-three cents.",
   "from": 1493,
   "len": 196
  },
  {
   "text": "I never saw it. One second there\u2019s fairway. The next second\u2026 there\u2019s just sky.",
   "from": 2274,
   "len": 181
  },
  {
   "text": "I remember thinking\u2026 we\u2019ve been in the air a while.",
   "from": 2462,
   "len": 106
  },
  {
   "text": "A twelve. He looked us in the eye\u2026 and said he was a twelve.",
   "from": 3656,
   "len": 147
  },
  {
   "text": "NO WAY!",
   "from": 5506,
   "len": 52
  },
  {
   "text": "IT WENT IN!",
   "from": 5561,
   "len": 48
  },
  {
   "text": "You still gotta chip, dude.",
   "from": 6254,
   "len": 60
  },
  {
   "text": "From the tee, that ball was in the hole. I still believe that.",
   "from": 6321,
   "len": 131
  },
  {
   "text": "Hey, Wix... you driving?",
   "from": 10802,
   "len": 77
  },
  {
   "text": "Fuck you.",
   "from": 10909,
   "len": 108
  }
 ],
 "lyrics": [
  {
   "text": "The Strand, the Strand, take me to the Strand",
   "from": 6849,
   "len": 138
  },
  {
   "text": "Hey\u2026 I\u2019m at the Strand, with all of my friends",
   "from": 7038,
   "len": 90
  },
  {
   "text": "No, I don\u2019t want this night to end",
   "from": 7128,
   "len": 54
  },
  {
   "text": "\u2019Cause I\u2019m at the Strand, with all of my friends",
   "from": 7185,
   "len": 75
  },
  {
   "text": "By the bay, in Monterey, it\u2019s the Strand \u2014 ay, ay",
   "from": 7275,
   "len": 150
  },
  {
   "text": "New putter Tone, and Kaners in the zone",
   "from": 7461,
   "len": 108
  },
  {
   "text": "So tee it high, boys, let it fly",
